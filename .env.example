# Copy this file to .env and fill it in. .env is ignored by git, so what you put there stays off GitHub.

# Required: the Sodexo menu API key. The UC Dining website sends it from your own browser;
# the README's "Get the menu API key" section shows where to copy it from.
SODEXO_API_KEY=

# Optional: use a Postgres database instead of the local SQLite file (uc_menu.db).
# Leave it commented out unless you're hosting the app (PROJECT_SPEC.md section 6.6).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
